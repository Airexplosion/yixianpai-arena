{
  "id": "com.yx.arena",
  "name": "练习场",
  "version": "0.16.7",
  "author": "yxp",
  "description": "补齐复盘导入可缺省的附加记录并细化报错位置，保护悟剑、玉瓶、共鸣和刻印读取。保留 0.16.6 发牌图鉴与五行阵旗修复、复盘轮次仙命快照、快捷发牌、澄心剑和残局求解联动。",
  "sdkVersion": ">=1.0.0 <2.0.0",
  "sandboxOnly": true,
  "entry": "plugins/Arena.dll",
  "entryType": "YxArena.ArenaMod",
  "provides": {
    "hooks": [
      "CardPanel.MoveToGrid",
      "CardPanel.MoveToHand",
      "CardPanel.TryUpgradeHandCard",
      "CardPanel.TryFuseHandCard",
      "CardPanel.InsertCard",
      "CardGridCunQuItem.MoveCardToGrid",
      "CardGridCunQuItem.MoveCardToHand",
      "Talent199Panel.OnShow",
      "Talent199Panel.OnHide",
      "CardPanel.RefineCardAsync",
      "CardPanel.ReplaceCardAsync",
      "CardPanel.ReloadCardOrder",
      "BattleManager.GameStatusReq",
      "BattleManager.SelfInfoReq",
      "BattleManager.SettleResultReq",
      "BattleManager.OnReciveGameStatusPositiveAction",
      "RecordDetailPanel.Review",
      "RecordDetailPanel.OnReviewBtnClick",
      "IllustrationCardItem.OnPointerClick",
      "ReadyCountdownButton.Click",
      "SettingsPanel.OnReturnButtonClick",
      "SinglePlayerModeItem.OnClick",
      "RogueModePart.OnShow",
      "SinglePlayerRoomPanel.OnGameButtonClick",
      "TalentItem.OnClick",
